{
    "name": "designmynight/laravel-log-mailer",
    "description": "A package to support logging via email in Laravel",
    "homepage": "https://github.com/designmynight/laravel-log-mailer",
    "license": "MIT",
    "keywords": [
        "laravel",
        "laravel-logging",
        "laravel-log-mailer",
        "monolog",
        "designmynight"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/log": "^12.0 || ^13.0",
        "illuminate/mail": "^12.0 || ^13.0",
        "monolog/monolog": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "DesignMyNight\\Laravel\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DesignMyNight\\Laravel\\Tests\\": "tests"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5"
    },
    "authors": [
        {
            "name": "Steve Porter",
            "email": "steve@designmynight.com",
            "role": "Developer"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "DesignMyNight\\Laravel\\Logging\\MailableLogServiceProvider"
            ]
        }
    }
}
